#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define RUS 1
#define SYM 2
#define ARR 3
#define NUM 4
#define BT 5
#define FF 6

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };

    macros {
        macro_rus: macro_rus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &tog RUS>;
        };

        th_macro: th_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H>;
        };

        tion_macro: tion_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp I &kp O &kp N>;
            label = "TION_MACRO";
        };

        ing_macro: ing_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I &kp N &kp G>;
            label = "ING_MACRO";
        };
    };

    combos {
        compatible = "zmk,combos";

        // POINT FINGERS - HIGH ROW = Caps Word (Turns off on Space)

        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <3 6>;
            bindings = <&caps_word>;
        };

        // POINT FINGERS = Hard Caps Lock (Traditional Toggle)

        combo_caps_lock {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp CAPS>;
        };

        // Toggle BT-Layer by pressing both inner thumbs (32 and 33)

        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo BT>;
        };

        // Toggle RUS-Layer by CLICKING both outer thumbs (30 and 35)

        combo_rus {
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&macro_rus>;
            layers = <DEF RUS>;
        };

        // Parentheses

        combo_lpar {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp LPAR>;
        };

        combo_rpar {
            timeout-ms = <50>; // somehow right parentheses works bad for me
            key-positions = <7 8>;
            bindings = <&kp RPAR>;
        };

        // Square Brackets

        combo_lbkt {
            timeout-ms = <40>;
            key-positions = <11 12>;
            bindings = <&kp LBKT>;
        };

        combo_rbkt {
            timeout-ms = <40>;
            key-positions = <17 18>;
            bindings = <&kp RBKT>;
        };

        // Curly Brackets

        combo_lbrc {
            timeout-ms = <40>;
            key-positions = <21 22>;
            bindings = <&kp LBRC>;
        };

        combo_rbrc {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&kp RBRC>;
        };

        // Word macros

        combo_th {
            timeout-ms = <40>;
            key-positions = <12 17>;
            bindings = <&th_macro>;
        };

        combo_ing {
            timeout-ms = <40>;
            key-positions = <2 7>;
            bindings = <&ing_macro>;
        };

        combo_tion {
            timeout-ms = <40>;
            key-positions = <22 27>;
            bindings = <&tion_macro>;
        };
    };

    behaviors {
        esc_cmd: esc_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;

            // quick-tap-ms = <125>;
            // hold-trigger-on-release;

            bindings = <&kp>, <&kp>;
        };

        // Refined Home Row Shift
        // require-prior-idle-ms ensures no accidental shifts while typing fast.

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            // require-prior-idle-ms = <125>; // remove since blocks me from immediate trigger shift after BSPC
        };

        lt_fast: fast_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";       // Triggers 'hold' if another key is pressed
            tapping-term-ms = <150>;    // Lower term for faster response
            quick-tap-ms = <140>;       // Allows for tap repetition
            bindings = <&mo>, <&kp>;
        };

        // not using - but can in future - CMD as a tap == CMD + TAB

        cmd_tab: cmd_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
  &kp Q  &kp W  &kp C              &kp R         &kp K               &kp Y               &kp U               &kp I        &kp O       &kp P
  &kp A  &kp S  &kp D              &hm LSHIFT F  &kp G               &kp H               &hm RSHIFT E        &kp T        &kp L       &hm RCTRL SEMI
  &kp Z  &kp X  &kp J              &kp V         &kp B               &kp N               &kp M               &kp COMMA    &kp PERIOD  &kp FSLH
                &esc_cmd LALT ESC  &kp LGUI      &lt_fast SYM TAB    &lt_fast ARR ENTER  &lt_fast NUM SPACE  &lt FF BSPC
            >;
        };

        rus_layer {
            display-name = "RUS";
            bindings = <
  &kp Q         &kp W  &kp E              &kp R     &kp T               &kp Y               &kp U               &kp I        &kp O       &kp P
  &hm LSHIFT A  &kp S  &hm LCTRL D        &kp F     &kp G               &kp H               &kp J               &kp K        &kp L       &hm RCTRL SEMI
  &kp Z         &kp X  &kp C              &kp V     &kp B               &kp N               &kp M               &kp COMMA    &kp PERIOD  &kp FSLH
                       &esc_cmd LALT ESC  &kp LGUI  &lt_fast SYM TAB    &lt_fast ARR ENTER  &lt_fast NUM SPACE  &lt FF BSPC
            >;
        };

        // 1: SYM
        //  & *               ` ' " ? ~
        //  $ % ^             | + - = : p
        //  ! @ #             \ _ < > ?

        brackets_layer {
            display-name = "SYM";
            bindings = <
  &none  &kp AMPS  &kp ASTRK  &none      &none     &kp GRAVE      &kp SQT    &kp DQT    &kp EXCL   &kp TILDE
  &none  &kp DLLR  &kp PRCNT  &kp CARET  &none     &kp PIPE       &kp PLUS   &kp MINUS  &kp EQUAL  &kp COLON
  &none  &kp EXCL  &kp AT     &kp HASH   &none     &kp BACKSLASH  &kp UNDER  &kp LT     &kp GT     &kp QUESTION
                   &trans     &trans     &trans    &trans         &trans     &trans
            >;
        };

        //  2: ARR

        nav_layer {
            display-name = "ARR";
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &kp PG_UP  &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &none
  &trans  &trans  &trans  &trans  &trans    &none      &kp LEFT      &kp DOWN  &kp RIGHT      &trans
  &trans  &trans  &trans  &trans  &trans    &kp PG_DN  &kp HOME      &none     &kp END        &none
                  &trans  &trans  &trans    &trans     &trans        &trans
            >;
        };

        // 3: NUM

        numpad_layer {
            display-name = "NUM";
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &none   &kp N7  &kp N8  &kp N9  &none
  &trans  &trans  &trans  &trans  &trans    &none   &kp N4  &kp N5  &kp N6  &kp N0
  &trans  &trans  &trans  &trans  &trans    &none   &kp N1  &kp N2  &kp N3  &none
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        // 4: BT

        symbol_layer {
            display-name = "BT";
            bindings = <
  &bt BT_CLR  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans
  &trans      &trans  &trans  &trans  &trans    &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans
  &trans      &trans  &trans  &trans  &trans    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans
                      &trans  &trans  &trans    &trans  &trans        &trans
            >;
        };

        // Layer 5: FF

        f_layer {
            display-name = "FF";
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &kp F12  &kp F7  &kp F8  &kp F9  &none
  &trans  &trans  &trans  &trans  &trans    &kp F11  &kp F4  &kp F5  &kp F6  &none
  &trans  &trans  &trans  &trans  &trans    &kp F10  &kp F1  &kp F2  &kp F3  &none
                  &trans  &trans  &trans    &trans   &trans  &trans
            >;
        };
    };
};
